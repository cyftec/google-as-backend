{
  "name": "@cyftec/drive-socket",
  "version": "0.5.1",
  "description": "Google Drive appDataFolder messaging for static PWAs — push, receive, and prune immutable file messages over HTTP.",
  "license": "MIT",
  "author": "Cyftec",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyftec/drive-socket.git"
  },
  "bugs": {
    "url": "https://github.com/cyftec/drive-socket/issues"
  },
  "homepage": "https://github.com/cyftec/drive-socket#readme",
  "keywords": [
    "google-drive",
    "drive",
    "appdata",
    "pwa",
    "messaging",
    "websocket-alternative",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test:typecheck": "bun typecheck",
    "test:runtime": "bun test",
    "tests": "bun run test:runtime && bun run test:typecheck",
    "prepublishOnly": "bun tests"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
