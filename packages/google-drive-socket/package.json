{
  "name": "@cyftec/google-drive-socket",
  "version": "0.1.0",
  "description": "Google Drive appDataFolder messaging for static PWAs \u2014 push, receive, and prune immutable file messages over HTTP.",
  "license": "MIT",
  "author": "Cyftec",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyftec/drive-socket.git"
  },
  "bugs": {
    "url": "https://github.com/cyftec/drive-socket/issues"
  },
  "homepage": "https://github.com/cyftec/drive-socket#readme",
  "keywords": [
    "google-drive",
    "drive",
    "appdata",
    "pwa",
    "oauth",
    "messaging",
    "websocket-alternative",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "bun x tsc --noEmit && bun x tsc --noEmit -p tsconfig.tests.json",
    "test:runtime": "bun test",
    "tests": "bun run test:runtime && bun run typecheck",
    "prepublishOnly": "bun tests"
  },
  "dependencies": {
    "@cyftec/google-oauth": "workspace:*",
    "@cyftec/google-drive-folder": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
